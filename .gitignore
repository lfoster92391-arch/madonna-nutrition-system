# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Windows reserved device name (accidental creation breaks git add)
/NUL

# Agent / local debug artifacts
/_*.txt
/_*.log
/_tmp*
/analytics-dump.txt
/build-*.log
/build-*.txt
/fix-encoding-result*.json
/next-build*.log
/scan-*.txt
/scan-*.json
/tsc*.txt
/tsc*.log
/tmp*.txt
/verify-*.log